print(df.duplicated().sum())
#Removing Duplicates
df=df.drop_duplicates()
print(df.duplicated().sum())
print(df[["Date","Category"]].head(10))
#Standardize Text
df["Category"]=df["Category"].str.strip().str.title()
print(df[["Date","Category"]].head(10))
